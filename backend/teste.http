################
### 1. Teste de aplicação rodando
################
GET http://localhost:3000
Accept: application/json


################
### 2. Teste de cadastro de cliente
################

### 2.1 Cadastro 1
POST http://localhost:3000/cliente 
Content-Type: application/json

{
    "nome": "Rafael",
    "email": "rafael@gmail.com",
    "senha": "abc",
    "cpf": "12345678912",
    "endereco": "rua xyz",
    "telefone": "48996054892"
}

### 2.2 Cadastro 2
POST http://localhost:3000/cliente 
Content-Type: application/json

{
    "nome": "José",
    "email": "jose@gmail.com",
    "senha": "cba",
    "cpf": "49586710123",
    "endereco": "rua abc",
    "telefone": "48996045982"
}


################
### 3. Teste de login
################
# @name loginReq
POST http://localhost:3000/login
Content-Type: application/json

{
    "email": "rafael@gmail.com",
    "senha": "abc"
}


################
### 4. Teste de listagem de clientes
################
GET http://localhost:3000/clientes
Content-Type: application/json
Authorization: {{loginReq.response.body.token}}


################
### 5. Teste de consulta de clientes
################

### 5.1 Consulta por código 1 (Rafael)
GET http://localhost:3000/cliente/1
Content-Type: application/json
Authorization: {{loginReq.response.body.token}}

### 5.2 Consulta por nome (Rafael)
GET http://localhost:3000/cliente/buscarNome/Rafael
Content-Type: application/json
Authorization: {{loginReq.response.body.token}}


################
### 6. Teste de atualização de clientes
################

### 6.1 Atualizar email do Rafael
PUT http://localhost:3000/cliente/1
Content-Type: application/json
Authorization: {{loginReq.response.body.token}}

{
    "nome": "Rafael",
    "email": "rafaelnovo@gmail.com",
    "senha": "abc",
    "cpf": "12345678912",
    "endereco": "rua xyz",
    "telefone": "48996054892"
}


################
### 7. Teste de apagar clientes
################

### 7.1 Apagar usuário de código 2 (José)
DELETE http://localhost:3000/cliente/2 
Content-Type: application/json
Authorization: {{loginReq.response.body.token}}



