Authorization: {{loginReq.response.body.token}}

{
  "codAgendamento": "1",
  "data": "2026-10-25",
  "hora": "16:25:00",
  "tipo": "MANUTENCAO",
  "codVeiculo": "1",
  "codCliente": "1"
}